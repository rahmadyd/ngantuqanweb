{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngantuqanweb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Mengaktifkan Node.js API di runtime Workers.
    "nodejs_compat",
    // Mengizinkan fetch ke URL publik dari worker.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Harus sama dengan "name" di atas.
      "service": "ngantuqanweb"
    }
  ],
  "r2_buckets": [
    {
      // Cache inkremental Next.js (revalidatePath / revalidateTag).
      // Buat bucket-nya lebih dulu: npx wrangler r2 bucket create ngantuqanweb-inc-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ngantuqanweb-inc-cache"
    }
  ],
  "kv_namespaces": [
    {
      // KV namespace untuk tag cache (kv-next-tag-cache).
      // Buat namespace-nya: npx wrangler kv namespace create NEXT_TAG_CACHE_KV
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "961a712d1acd4f56995169232844e24c",
      "preview_id": "443e8173b8d34b6abb12f6e355f0b657"
    }
  ],
  "observability": {
    "enabled": true
  }
}
